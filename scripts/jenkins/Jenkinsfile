pipeline {
    agent any

    parameters {
        booleanParam(name: 'REMOTE_DEPLOY', defaultValue: false, description: 'EC2 Redis에 배포 (SSH 터널)')
    }

    environment {
        PYTHONPATH   = "${WORKSPACE}/backend"
        HF_HOME      = '/var/jenkins_home/model-cache/huggingface'
        PYTHON       = "${WORKSPACE}/venv/bin/python"

        KAKAO_API_KEY       = credentials('KAKAO_API_KEY')
        ANTHROPIC_API_KEY   = credentials('ANTHROPIC_API_KEY')
        NAVER_CLIENT_ID     = credentials('NAVER_CLIENT_ID')
        NAVER_CLIENT_SECRET = credentials('NAVER_CLIENT_SECRET')

        EC2_HOST     = credentials('EC2_HOST')
        EC2_KEY_PATH = credentials('EC2_SSH_KEY')
    }

    stages {

        stage('환경 설정') {
            steps {
                sh '''
                    test -d venv || python3 -m venv venv
                    venv/bin/pip install -r requirements.txt -q
                    venv/bin/playwright install chromium
                '''
            }
        }

        stage('초기화') {
            steps {
                sh 'mkdir -p data'
            }
        }

        stage('SSH 터널 오픈') {
            when { expression { params.REMOTE_DEPLOY } }
            steps {
                sh '''
                    ssh -o StrictHostKeyChecking=no -i $EC2_KEY_PATH \
                        -L 16379:localhost:6379 \
                        -N -f ec2-user@$EC2_HOST
                '''
            }
        }

        stage('수집: 카카오') {
            steps {
                withEnv(["REDIS_URL=${params.REMOTE_DEPLOY ? 'redis://localhost:16379' : 'redis://host.docker.internal:6379'}"]) {
                    sh '$PYTHON scripts/pipeline.py collect-kakao'
                }
            }
        }

        stage('수집: 네이버') {
            steps {
                withEnv(["REDIS_URL=${params.REMOTE_DEPLOY ? 'redis://localhost:16379' : 'redis://host.docker.internal:6379'}"]) {
                    sh '$PYTHON scripts/pipeline.py collect-naver'
                }
            }
        }

        stage('병합') {
            steps {
                withEnv(["REDIS_URL=${params.REMOTE_DEPLOY ? 'redis://localhost:16379' : 'redis://host.docker.internal:6379'}"]) {
                    sh '$PYTHON scripts/pipeline.py merge'
                }
            }
        }

        stage('임베딩: 장소') {
            steps {
                withEnv(["REDIS_URL=${params.REMOTE_DEPLOY ? 'redis://localhost:16379' : 'redis://host.docker.internal:6379'}"]) {
                    sh '$PYTHON scripts/pipeline.py embed-places --storage redis'
                }
            }
        }

        stage('임베딩: 키워드') {
            steps {
                withEnv(["REDIS_URL=${params.REMOTE_DEPLOY ? 'redis://localhost:16379' : 'redis://host.docker.internal:6379'}"]) {
                    sh '$PYTHON scripts/pipeline.py embed-search-keywords --storage redis'
                }
            }
        }

    }

    post {
        always {
            sh 'pkill -f "ssh.*16379" || true'
        }
        success {
            echo '파이프라인 완료 — Redis 데이터 갱신됨'
        }
        failure {
            echo '파이프라인 실패 — 위 단계 로그 확인'
        }
    }
}
